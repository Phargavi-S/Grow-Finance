# Backend environment variables (copy to .env and fill values)
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/billingDB
SESSION_SECRET=replace_with_secure_secret

# Public frontend origin used for CORS and password-reset links.
# In production this MUST be set to the live site URL. Do not leave it blank.
FRONTEND_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=billing@your-verified-domain.com
EMAIL_ENABLED=true
COMPANY_NAME=Your Company

# Company info used in PDFs and email
COMPANY_ADDRESS_LINE1=123 Business Rd
COMPANY_ADDRESS_LINE2=
COMPANY_CITY_STATE_ZIP=12345 City
COMPANY_COUNTRY=Germany
COMPANY_EMAIL=billing@yourcompany.com
COMPANY_PHONE=+1-555-000-0000
COMPANY_WEBSITE=
COMPANY_VAT_ID=
COMPANY_TAX_NUMBER=
COMPANY_OWNER=
COMPANY_BANK=
COMPANY_IBAN=
COMPANY_BIC=

# Currency symbol shown in PDFs/emails
CURRENCY_SYMBOL=€

# Optional timezone for the 9 AM reminder cron (example: Europe/Berlin)
# CRON_TIMEZONE=Europe/Berlin

# Logo path for invoice/PO PDF generation (transparent PNG recommended)
LOGO_PATH=./assets/growvia-logo.png
